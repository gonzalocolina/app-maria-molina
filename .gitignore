# Android / Gradle .gitignore
# Generated for Android Studio + Gradle projects

# Gradle
.gradle/
build/
**/build/

# Local configuration
/local.properties
.gradle/

# Signing keys
*.jks
*.keystore

# Android Studio
/.idea/
.idea/*
*.iml

# IntelliJ
*.iws
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml

# Kotlin/Java
*.class
*.jar
*.war
*.ear

# Generated files
captures/
outputs/
.externalNativeBuild/
.cxx/

# Native / JNI
*.so
obj/

# Android packages
*.apk
*.ap_
*.aab

# Google services config (may contain API keys). Review whether you want to track this file.
# If you intentionally commit google-services.json, remove the following line.
/app/google-services.json

# Misc
.DS_Store
*.log
*.tmp
*.swp

# Firebase / Crashlytics
crashlytics/

# Unit test outputs
test-results/

# Gradle wrapper
gradle-wrapper.jar

# Coverage
coverage/

# JetBrains Rider
.idea/
*.suo
*.user

# OS files
Thumbs.db
desktop.ini

# Captured screenshots and builds
captures/

# Local Gradle cache
.gradle

# End of file

