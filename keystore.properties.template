# Keystore configuration for release signing
# DO NOT commit this file with real values to version control!
#
# Instructions:
# 1. Generate a keystore using Android Studio or keytool:
#    keytool -genkey -v -keystore mariamolina-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias mariamolina
#
# 2. Fill in the values below with your keystore information
# 3. Save this file as keystore.properties (without .template)

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=mariamolina
storeFile=../mariamolina-release.jks

